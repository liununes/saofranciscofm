# Public values required by the Vite build.
# Never put a Supabase service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://appliu-supabase.ceip2y.easypanel.host
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# Optional relay settings. Add any host used by the radio stream.
STREAM_SOURCE_URL=https://stm28.srvaudio.com.br:10884/
STREAM_ALLOWED_HOSTS=stm28.srvaudio.com.br
PORT=80
